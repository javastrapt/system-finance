[
    {
        "id": "spacing",
        "category": "Spacing",
        "utilities": [
            {
                "code": "m",
                "element": "Margin",
                "desc": "Controls the outer space around an element."
            },
            {
                "code": "p",
                "element": "Padding",
                "desc": "Controls the inner space within an element."
            },
            {
                "code": "t",
                "element": "Top",
                "desc": "Applies the spacing to the top side (e.g., mt-3, pt-2)."
            },
            {
                "code": "b",
                "element": "Bottom",
                "desc": "Applies the spacing to the bottom side (e.g., mb-4, pb-1)."
            },
            {
                "code": "s",
                "element": "Start",
                "desc": "Applies spacing to the left in LTR (Left-to-Right) layouts."
            },
            {
                "code": "e",
                "element": "End",
                "desc": "Applies spacing to the right in LTR (Left-to-Right) layouts."
            },
            {
                "code": "x",
                "element": "X-Axis",
                "desc": "Applies spacing to both the left and right sides horizontally."
            },
            {
                "code": "y",
                "element": "Y-Axis",
                "desc": "Applies spacing to both the top and bottom sides vertically."
            },
            {
                "code": "blank",
                "element": "All sides",
                "desc": "Using just m-3 or p-3 applies it to all four sides."
            },
            {
                "code": "auto",
                "element": "Automatic",
                "desc": "m-auto, mx-auto, etc. (Used heavily for centering elements)."
            },
            {
                "code": "0 to 5",
                "element": "Size Scales",
                "desc": "0 (eliminates space) up to 5 (maximum default spacing standard)."
            }
        ]
    },
