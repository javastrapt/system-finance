---
import siteData from '../data/site.json';

const pathname= Astro.url.pathname;
const site = siteData.find((item) => item.id ==='site')
const pages = site.pages;
const currentPage = pages.find((page) => page.slug === pathname);

const hero = currentPage.hero;
const image = currentPage.image;
---
<!-- Responsive Left-Aligned Hero  -->
  <main>
    <section class='container col-xxl-8 px-4 py-5'>
      <div class='row flex-lg-row-reverse align-items-center g-5 py-5'>
        <div class='col-10 col-sm-8 col-lg-6'>
          <img src="https://tinyurl.com/systemflo-white" class="d-block mx-lg-auto img-fluid" alt='system-flo-logo' width='700' height='500'>
        </div>
        <div class='col-lg-6'>
          <h1 class='display-5 fw-bold lh-1 mb-03'>Responsive Left-Aligned Hero with Image</h1>
          <p class='lead'>Quickly (but not hastily) design and customize responsive mobile-first sites with Bootstrap, the world's most popular front-end open source toolkit, featuring Sass variables and mix-ins, responsive grid sytstem, extensive prebuild components, and powerful Javascript plugins</p>
          <div class='d-grid gap-2 d-md-flex justify-content-md-start'>
            <button type="button" class='btn btn-lg px-4 me-md-2'>Primary Button</button>
            <button type='button' class='btn btn-outline-secondary btn-lg px-4'>Default Button</button>
          </div>
        </div>
      </div>
    </section>
  </main>