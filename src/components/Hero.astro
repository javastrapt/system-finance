---
import siteData from '../data/site.json';

const pathname = Astro.url.pathname;
const pagePath = pathname === '/' ? pathname : pathname.replace(/\/+$/, '');

const pages = siteData.find(
    item => item.id === 'site'
)?.pages ?? [];

const currentPage = pages.find(page => page.slug === pagePath);
    
if (!currentPage) {
    throw new Error(`No page found for ${pathname}`)
}

const hero = currentPage.hero;

---

<div class="hero-container bg-dark text-secondary rounded-2 px-3 py-2">
  <div class="hero container py-0">
    <h1 class="display-5 fw-bold text-white mb-2 hero-title">{hero.title}</h1>
    <p class="hero-subtitle fs-5 mb-5">{hero.subtitle}</p>
    <slot />
  </div>
</div>

<style>

  .hero-container {
    width: 100%;
    height: fit-content;
  }
  .hero {
    width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;

  }
</style>