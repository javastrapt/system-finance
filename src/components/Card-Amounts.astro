---
/**
 * Currently, this is an HTML markup dump from finance.astro
 * Fix it to work wirth astro
 */
---

<!-- for each item that you want display, create a column with side margins at 2, and then a display card to display the item information -->
<div class="col mx-2">
  <div class="card shadow-sm summary-card">
    <div class="card-body">
      <h2 class="card-title fw-light amount">{totalCharges}</h2>
      <h4 class="label card-subtitle text-secondary fw-bold">Total Charges</h4>
    </div>
  </div>
</div>
