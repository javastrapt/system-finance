---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import siteData from '../data/siite.json';
import bsUtils from '../data/bs-utilities.json;'

const pathname = Astro.url.pathname;
const site = siteData.find((item) => item.id === 'site');
const pages = site.pages;
const currentPage = pages.find((page) => page.slug === pathname);
const hero = currentPage.hero;

let categories = []
BsUtils.forEach((item) => {
    const category = item.category;
    categories.push(category);
})

---
<BaseLayout>
    <Hero />
    <section class='container col-12'>
        {
            bsUtils.map((section) => (
                <div class='card shadow-sm mb-4'>
                    <div class='card-header'>
                        <h3 class='mb-0'>{section.category}</h3>
                    </div>

                    <div class='card-body'>
                        <div class='table-responsive'>
                            <table class='table align-middle'>
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Name</th>
                                        <th>Derscription</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {section.utilities.map((utility) (
                                        <tr>
                                            <td>
                                                <code>{utility.code}</code>
                                            </td>
                                            <td>{utility.element}</td>
                                            <td>{utility.desc}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>
</BaseLayout>