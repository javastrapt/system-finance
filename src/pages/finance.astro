---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/glowcards.css";
import Hero from "../components/Hero.astro";
import transactions from "../data/transactions.json";
import Alert from "../components/Alert.astro";

const sortedTransactions = [...transactions].sort(
  (a, b) => Number(new Date(b.postDate)) - Number(new Date(a.postDate)),
);

const formatter = Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
});

const chargesRaw = transactions
  .filter((item) => item.type?.toLowerCase() === "charge")
  .reduce((sum, item) => sum + Number(item.amount || 0), 0);

const paymentsRaw = transactions
  .filter((item) => item.type?.toLowerCase() === "payment")
  .reduce((sum, item) => sum + Number(item.amount || 0), 0);

const balanceRaw = Number((chargesRaw - paymentsRaw).toFixed(2));

const totalCharges = formatter.format(chargesRaw);
const totalPayments = formatter.format(paymentsRaw);
const balance = formatter.format(balanceRaw);
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Finance">
  <Alert
    triggerSelector="#transForm"
    type="success"
    message="Record added successfully - check the transaction datatable for confirmation!"
  />
  <Hero>
    <div class="d-flex align-items-center">
      <button
        class="btn btn-outline-info btn-lg px-4 me-sm-3 fw-bold"
        data-bs-toggle="modal"
        data-bs-target="#addRecord"
        id="btn-add-record"
      >
        Add Record
      </button>
      <button
        type="button"
        class="btn btn-outline-light btn-lg px-4"
        data-bs-toggle="modal"
        data-bs-target="#viewSummary"
        id="btn-view-summary"
      >
        View Summary
      </button>
    </div>
  </Hero>

  <section class="totals-container my-4">
    <div class="row g-3">
      <div class="col-12 col-md-4">
        <div class="card shadow-sm summary-card" id="charges">
          <div class="card-body">
            <h2 class="card-title fw-light amount">{totalCharges}</h2>
            <h4 class="label card-subtitle text-secondary fw-bold">
              Total Charges
            </h4>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card summary-card shadow" id="payments">
          <div class="card-body">
            <h2 class="card-title fw-light amount">{totalPayments}</h2>
            <h4 class="label card-subtitle text-secondary fw-bold">
              Total Payments
            </h4>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card summary-card shadow-sm" id="balance">
          <div class="card-body">
            <h2 class="card-title fw-light amount">{balance}</h2>
            <h4 class="label card-subtitle text-secondary fw-bold">Balance</h4>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <h1 class="col-12 px-2 py-3 display-4 fw-light">Transaction History</h1>
      <table
        class="table table-responsive table-striped table-dark table-hover"
      >
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Description</th>
            <th>Post Date</th>
            <th>Amount</th>
            <th>Service</th>
          </tr>
        </thead>
        <tbody>
          {
            sortedTransactions.map((transaction) => (
              <tr>
                <td>{transaction.transId}</td>
                <td>{transaction.type}</td>
                <td>{transaction.desc}</td>
                <td>{transaction.postDate}</td>
                <td>{formatter.format(Number(transaction.amount))}</td>
                <td>{transaction.service}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="modal fade" id="addRecord" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content rounded-4 shadow">
          <div class="modal-header border-bottom-0">
            <h1 class="modal-title display-5 fw-thin">Add Record</h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <div class="modal-body py-0">
            <form id="transForm" action="/submit" method="POST">
              <div class="row mb-2">
                <div class="col floating-form">
                  <label for="type" class="form-label">Transaction Type</label>
                  <select id="type" name="type" class="form-control" required>
                    <option disabled selected>Type Select...</option>
                  </select>
                </div>

                <div class="col form-floating">
                  <input
                    type="text"
                    id="desc"
                    name="desc"
                    class="form-control"
                    placeholder="Description"
                    required
                  />
                  <label for="desc" class="form-label">Description</label>
                </div>
              </div>

              <div class="row mb-2">
                <div class="col">
                  <label for="postDate" class="form-label">Post Date</label>
                  <input
                    type="date"
                    id="postDate"
                    name="postDate"
                    class="form-control"
                    value={today}
                  />
                </div>
                <div class="col form-floating">
                  <input
                    type="number"
                    id="amount"
                    name="amount"
                    class="form-control"
                    step="0.01"
                    required
                  />
                  <label for="amount" class="form-label">Amount</label>
                </div>
              </div>

              <div class="row mb-2">
                <div class="col">
                  <label for="service" class="form-label">Service Used</label>
                  <select
                    id="service"
                    name="service"
                    class="form-select"
                    required
                  >
                    <option disabled selected>Service Select...</option>
                  </select>
                </div>
              </div>
            </form>
          </div>

          <div
            class="modal-footer flex-column align-items-stretch w-100 gap-2 pb-3 border-top-0"
          >
            <button
              type="submit"
              form="transForm"
              class="btn btn-lg btn-primary"
            >
              Submit
            </button>
            <button
              type="button"
              class="btn btn-lg btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="viewSummary" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content rounded-4 shadow">
          <div class="modal-header border-bottom-0">
            <h1 class="modal-title fs-5">View Summary</h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <div class="modal-body py-0">
            <p class="mb-3">Charges: {totalCharges}</p>
            <p class="mb-3">Payments: {totalPayments}</p>
            <p class="mb-0">Balance: {balance}</p>
          </div>

          <div
            class="modal-footer flex-column align-items-stretch w-100 gap-2 pb-3 border-top-0"
          >
            <button
              type="button"
              class="btn btn-lg btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const types = ["Charge", "Payment"];
    const services = [
      "Zelle",
      "Paypal",
      "Venmo",
      "Chime",
      "CashApp",
      "Check",
      "Money Order",
      "Cash",
    ];

    const addForm = document.getElementById("transForm");
    const typeSelect = document.getElementById("type");
    const descEl = document.getElementById("desc");
    const serviceSelect = document.getElementById("service");

    document.addEventListener("DOMContentLoaded", () => {
      if (!typeSelect || !serviceSelect) return;

      types.forEach((type) => {
        const option = document.createElement("option");
        option.value = type.toLowerCase();
        option.textContent = type;
        typeSelect.appendChild(option);
      });

      services.forEach((service) => {
        const option = document.createElement("option");
        option.value = service.toLowerCase();
        option.textContent = service;
        serviceSelect.appendChild(option);
      });
    });

    typeSelect?.addEventListener("change", () => {
      if (!descEl) return;

      if (typeSelect.value === "charge") {
        const date = new Date();
        const month = date.toLocaleString("default", { month: "long" });
        const year = date.getFullYear();
        descEl.value = `${month} ${year} rent`;
        return;
      }

      descEl.value = "Thank you for your payment";
    });

    addForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(addForm);
      const data = Object.fromEntries(formData.entries());

      try {
        await fetch("http://localhost:3000/api/transactions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
      } catch (error) {
        console.error(error);
      }
    });
  </script>

  <style>
    .modal {
      backdrop-filter: blur(10px);
    }

    .hero {
      width: 100%;
      display: flex;
      align-items: center;
      flex-direction: row;
    }
  </style>
</BaseLayout>
